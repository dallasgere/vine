{
  "name": "vine",
  "displayName": "Vine Theme Pack",
  "icon": "assets/vine.png",
  "description": "A collection of dark VS Code themes inspired by favorite editor palettes, with bordered and unbordered variants.",
  "version": "1.20.2",
  "publisher": "local-themes",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "vine",
    "dark",
    "themes",
    "sea-glass",
    "contrast",
    "accessibility"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/check.mjs",
    "package": "npm run build && npm test && python3 scripts/package.py"
  },
  "contributes": {
