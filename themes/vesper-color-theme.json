    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E2C08D",
        "fontStyle": ""
      }
    },
    {
      "name": "Function and method references",
      "scope": [
        "variable.function"
      ],
      "settings": {
        "foreground": "#FFC799",
        "fontStyle": ""
      }
    },
    {
      "name": "Enum member references",
      "scope": [
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#E0E0E0",
        "fontStyle": ""
      }
    }
