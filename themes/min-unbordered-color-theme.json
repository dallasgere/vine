  "tokenColors": [
    {
      "name": "Plain text and variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "entity.name.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9ca3ad",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and parameters",
      "scope": [
        "variable.other.property",
        "variable.parameter",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ededed",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9ca3ad",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#9bcfa6",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e39a9a",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#dcc48f",
        "fontStyle": ""
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.method-call entity.name.function",
        "entity.name.function.tagged-template"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Function and method definition names",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Library functions",
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Declaration names",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Type references",
      "scope": [
        "entity.name.type.ts",
        "entity.name.type.tsx"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "TypeScript type declarations",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.alias",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Embedded expressions",
      "scope": [
        "meta.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    },
    {
      "name": "Object keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.jsonc",
        "string.quoted.double.json entity.name.tag",
        "string.quoted.double.jsonc entity.name.tag"
      ],
      "settings": {
        "foreground": "#d8dce3",
        "fontStyle": ""
      }
    }
  ],
