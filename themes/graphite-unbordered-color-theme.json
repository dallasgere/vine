  "tokenColors": [
    {
      "name": "Plain text and variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "entity.name.variable",
        "support.variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b8bbc4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and parameters",
      "scope": [
        "variable.other.property",
        "variable.parameter",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#b8bbc4",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#f0f0f0",
        "fontStyle": ""
      }
    }
  ],
