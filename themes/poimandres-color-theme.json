  "tokenColors": [
    {
      "name": "Plain code and variables",
      "scope": [
        "variable",
        "meta.embedded",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#e4f0fb",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#a6accd",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8992b0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#a6accd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators and storage types",
      "scope": [
        "keyword.operator",
        "storage.type"
      ],
      "settings": {
        "foreground": "#91b4d5",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports and exports",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.module",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#5de4c7",
        "fontStyle": ""
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#5fb3a1",
        "fontStyle": ""
      }
    },
    {
      "name": "Creation and modifiers",
      "scope": [
        "keyword.operator.new",
        "keyword.control.new",
        "storage.modifier",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#5de4c7",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings and literals",
      "scope": [
        "string",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#5de4c7",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#add7ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#91b4d5",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters and properties",
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "variable.other.constant",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#e4f0fb",
        "fontStyle": ""
      }
    },
    {
      "name": "Object keys and CSS properties",
      "scope": [
        "support.type.property-name",
        "string.unquoted.label"
      ],
      "settings": {
        "foreground": "#add7ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags and components",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#5de4c7",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#91b4d5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "text.html.basic entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#5fb3a1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Absence and error handling",
      "scope": [
        "keyword.control.trycatch",
        "keyword.control.throw",
        "keyword.operator.expression.delete",
        "keyword.operator.expression.void",
        "keyword.operator.void",
        "keyword.operator.delete",
        "constant.language.null",
        "constant.language.boolean.false",
        "constant.language.undefined",
        "support.class.error"
      ],
      "settings": {
        "foreground": "#e084b2",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#e084b2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8992b0",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#5de4c7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e4f0fb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e4f0fb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#add7ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#89ddff",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#5de4c7",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e084b2",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#fffac2",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#91b4d5",
    "type": "#91b4d5",
    "class": "#91b4d5",
    "enum": "#91b4d5",
    "interface": "#91b4d5",
    "struct": "#91b4d5",
    "typeParameter": "#91b4d5",
    "variable": "#e4f0fb",
    "parameter": "#e4f0fb",
    "property": "#e4f0fb",
    "function": "#add7ff",
    "method": "#add7ff",
    "enumMember": "#5de4c7",
    "keyword": {
      "foreground": "#a6accd",
      "italic": true
    },
    "modifier": "#5de4c7",
    "operator": "#91b4d5",
    "comment": {
      "foreground": "#8992b0",
      "italic": true
    },
    "string": "#5de4c7",
    "number": "#5de4c7",
    "regexp": "#89ddff",
    "decorator": "#5fb3a1",
    "macro": "#add7ff",
    "newOperator": "#5de4c7",
    "*.deprecated": {
      "foreground": "#8992b0",
      "strikethrough": true
    }
  }
}
