  "tokenColors": [
    {
      "name": "Plain and embedded code",
      "scope": [
        "meta.embedded",
        "constant.other.placeholder",
        "source"
      ],
      "settings": {
        "foreground": "#d6deeb",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#9fd4b0",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#d6deeb",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9aa9ac",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#7fdbca",
        "fontStyle": ""
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports, exports, and control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "name": "Creation and modifiers",
      "scope": [
        "keyword.operator.new",
        "keyword.other.new",
        "variable.language"
      ],
      "settings": {
        "foreground": "#7fdbca",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#ecc48d",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f78c6c",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f78c6c",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#5ca7e4",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#82aaff",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ffcb8b",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d7dbe0",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#baebe2",
        "fontStyle": ""
      }
    },
    {
      "name": "Object keys and JSON keys",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name.json",
        "string.unquoted.label"
      ],
      "settings": {
        "foreground": "#7fdbca",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#80cbc4",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags and components",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#caece6",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9fd4b0",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator entity.name.function",
        "meta.decorator variable.other",
        "storage.type.annotation",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#9fd4b0",
        "fontStyle": ""
      }
    },
    {
      "name": "Absence and error handling",
      "scope": [
        "keyword.control.trycatch",
        "keyword.control.throw"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ef5451",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8693a2",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#82b1ff",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#9fd4b0",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c792ea",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
