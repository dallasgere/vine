  "tokenColors": [
    {
      "name": "Plain code",
      "scope": [
        "variable",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#d8dee9",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#909cac",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#99c794",
        "fontStyle": ""
      }
    },
    {
      "name": "Definition punctuation",
      "scope": [
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#5fb4b4",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "punctuation.definition.numeric.base"
      ],
      "settings": {
        "foreground": "#f9ae58",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#c695c6",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#ec5f66",
        "fontStyle": ""
      }
    },
    {
      "name": "Member variables",
      "scope": [
        "variable.member"
      ],
      "settings": {
        "foreground": "#ec5f66",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#c695c6",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f97b58",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#c695c6",
        "fontStyle": ""
      }
    },
    {
      "name": "Separators",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#909cac",
        "fontStyle": ""
      }
    },
    {
      "name": "Sections",
      "scope": [
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage"
      ],
      "settings": {
        "foreground": "#ec5f66",
        "fontStyle": ""
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type",
        "storage.type.numeric"
      ],
      "settings": {
        "foreground": "#c695c6",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#f9ae58",
        "fontStyle": ""
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#5fb4b4",
        "fontStyle": ""
      }
