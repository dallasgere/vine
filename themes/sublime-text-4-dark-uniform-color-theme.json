      ],
      "settings": {
        "foreground": "#5fb4b4",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "entity.name.decorator"
      ],
      "settings": {
        "foreground": "#6699cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Library functions",
      "scope": [
        "support.function",
        "support.macro"
      ],
      "settings": {
        "foreground": "#6699cc",
