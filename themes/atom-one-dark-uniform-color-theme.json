  "tokenColors": [
    {
      "name": "Plain and embedded code",
      "scope": [
        "meta.embedded",
        "constant.other.placeholder",
        "source"
      ],
      "settings": {
        "foreground": "#abb2bf",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#e5737c",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#abb2bf",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#989fac",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#c678dd",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
