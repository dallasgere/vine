  "tokenColors": [
    {
      "name": "Plain text and variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "entity.name.variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#e2e2e5",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#909ca8",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation keywords",
      "scope": [
        "keyword.other.documentation",
        "storage.type.class.doxygen",
        "punctuation.definition.keyword.doxygen"
      ],
      "settings": {
        "foreground": "#92a1b1",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#ef907a",
        "fontStyle": ""
      }
    },
    {
      "name": "String delimiters",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ef907a",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#d0bf69",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#ef84b0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e2e2e5",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#ef84b0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d0bf69",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#ef84b0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "Variable references",
      "scope": [
        "variable.other"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e2e2e5",
        "fontStyle": ""
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#ef84b0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type references",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "Library types",
      "scope": [
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#d4b8f5",
        "fontStyle": ""
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#ef84b0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#62a9bb",
        "fontStyle": ""
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "variable.function",
        "meta.function-call entity.name.function",
        "meta.method-call entity.name.function",
        "entity.name.function.tagged-template"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "Function and method definition names",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#62a9bb",
        "fontStyle": ""
      }
    },
    {
      "name": "Type declarations",
      "scope": [
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type.alias",
        "entity.name.type.module",
        "entity.name.type.struct.swift",
        "entity.name.type.protocol.swift",
        "entity.name.type.typealias.swift"
      ],
      "settings": {
        "foreground": "#6dc8e5",
        "fontStyle": ""
      }
    },
    {
      "name": "Library functions and constants",
      "scope": [
        "support.function",
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#b58ae6",
        "fontStyle": ""
      }
    },
    {
      "name": "Preprocessor directives and macros",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "support.macro"
      ],
      "settings": {
        "foreground": "#fd8f3f",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes and annotations",
      "scope": [
        "entity.other.attribute-name",
        "entity.name.decorator",
        "entity.name.function.decorator",
        "variable.annotation"
      ],
      "settings": {
        "foreground": "#c38d60",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#b4e1d4",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f48771",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#909ca8",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6dc8e5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e2e2e5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e2e2e5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#78a9ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#ef907a",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#81b88b",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f48771",
        "fontStyle": ""
      }
    },
