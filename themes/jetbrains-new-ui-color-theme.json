  "tokenColors": [
    {
      "name": "Plain code and variables",
      "scope": [
        "variable",
        "meta.embedded",
        "constant.other.placeholder",
        "source"
      ],
      "settings": {
        "foreground": "#BCBEC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#BCBEC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#92969c",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#BCBEC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Imports, exports, and control flow",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Creation and modifiers",
      "scope": [
        "keyword.operator.new",
        "storage.modifier",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#6AAB73",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#2AACB8",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#42C3D4",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#56A8F5",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#CED0D6",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BCBEC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": ""
      }
    },
    {
      "name": "Object keys and JSON keys",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name.json",
        "string.unquoted.label"
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags and components",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#D5B778",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BCBEC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator entity.name.function",
        "meta.decorator variable.other",
        "storage.type.annotation",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#B3AE60",
        "fontStyle": ""
      }
    },
    {
      "name": "Absence and error handling",
      "scope": [
        "keyword.control.trycatch",
        "keyword.control.throw",
        "support.class.error"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F75464",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#aeb0b5",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#BCBEC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#BCBEC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#56A8F5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#6AAB73",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#6AAB73",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F75464",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#F2C55C",
        "fontStyle": ""
      }
    }
  ],
