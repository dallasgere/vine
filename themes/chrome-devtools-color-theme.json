  "tokenColors": [
    {
      "name": "Plain text and variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "entity.name.variable",
        "support.variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#e3e3e3",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ababab",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#fe8d59",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#facc15",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#cc9aff",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a8c7fa",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#7cacf8",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#a8c7fa",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c4eed0",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and parameters",
      "scope": [
        "variable.other.property",
        "variable.parameter",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#e3e3e3",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7cacf8",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#cc9aff",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f2b8b5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ababab",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7cacf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e3e3e3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e3e3e3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#7cacf8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#fe8d59",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#6dd58c",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f2b8b5",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#facc15",
        "fontStyle": ""
      }
    },
    {
      "name": "DevTools properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#facc15",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#a8c7fa",
    "type": "#a8c7fa",
    "class": "#a8c7fa",
    "enum": "#a8c7fa",
    "interface": "#a8c7fa",
    "struct": "#a8c7fa",
    "typeParameter": "#a8c7fa",
    "parameter": "#e3e3e3",
    "variable": "#e3e3e3",
    "property": "#facc15",
    "enumMember": "#c4eed0",
    "function": "#7cacf8",
    "method": "#7cacf8",
    "macro": "#cc9aff",
    "keyword": "#cc9aff",
    "modifier": "#cc9aff",
    "comment": "#ababab",
    "string": "#fe8d59",
    "number": "#c4eed0",
    "regexp": "#facc15",
    "operator": "#a8c7fa",
    "decorator": "#cc9aff",
    "*.readonly": "#c4eed0",
    "*.deprecated": {
      "foreground": "#ababab",
      "strikethrough": true
    }
  }
}
