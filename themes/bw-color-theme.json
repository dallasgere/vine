      "underline": false
    },
    "operator": {
      "foreground": "#d0d0d0",
      "bold": false,
      "italic": false,
      "underline": false
    },
    "*.readonly": {
      "foreground": "#d0d0d0",
      "bold": true
    },
    "*.deprecated": {
      "foreground": "#929292",
      "strikethrough": true
    }
  }
}
