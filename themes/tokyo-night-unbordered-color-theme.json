  "tokenColors": [
    {
      "name": "Plain text and variables",
      "scope": [
        "variable",
        "meta.definition.variable",
        "entity.name.variable",
        "support.variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#c1caed",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8691ae",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#a1cb74",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#dab072",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#ba9cef",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#91d4f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#80a4f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#41c1d7",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f4a26e",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7dd4c5",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#80a4f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ba9cef",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid code",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated code",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8691ae",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#80a4f0",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#c1caed",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c1caed",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#80a4f0",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#a1cb74",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a1cb74",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletions",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f7768e",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#dab072",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#dab072",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#41c1d7",
    "type": "#41c1d7",
    "class": "#41c1d7",
    "enum": "#41c1d7",
    "interface": "#41c1d7",
    "struct": "#41c1d7",
    "typeParameter": "#41c1d7",
    "parameter": "#dab072",
    "variable": "#c1caed",
    "property": "#7dd4c5",
    "enumMember": "#f4a26e",
    "function": "#80a4f0",
    "method": "#80a4f0",
    "macro": "#ba9cef",
    "keyword": "#ba9cef",
    "modifier": "#ba9cef",
    "comment": "#8691ae",
    "string": "#a1cb74",
    "number": "#f4a26e",
    "regexp": "#dab072",
    "operator": "#91d4f0",
    "decorator": "#ba9cef",
    "*.deprecated": {
      "foreground": "#8691ae",
      "strikethrough": true
    }
  }
}
